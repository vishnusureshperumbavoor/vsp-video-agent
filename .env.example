# JarvisLabs API token used by scripts/wan_animate_runner.py
# Copy to .env (gitignored) and fill in.
JARVIS_LABS_API_TOKEN=

# Optional, for faster Hugging Face model downloads on the remote instance.
HF_TOKEN=

# --- Girlfriend image app: backend (FastAPI) ---
# Shared secret the Telegram bot presents; generate with `openssl rand -hex 32`.
BOT_INTERNAL_TOKEN=
TELEGRAM_BOT_TOKEN=
# Optional allowlist. Leave empty to let anyone use the bot; set a chat id to
# restrict the whole bot to one chat.
TELEGRAM_CHAT_ID=
# Only this Telegram user can create/select characters. /imagine is public.
TELEGRAM_OWNER_ID=
BACKEND_URL=http://localhost:8000
# Optional: absolute image URLs for web clients; Telegram does not need it.
PUBLIC_BASE_URL=
IMAGE_DB_PATH=data/girlfriend.db
DAILY_IMAGE_LIMIT=10
# Hard cap across all users, so an open bot cannot run up an unbounded GPU bill.
GLOBAL_DAILY_LIMIT=100
IMAGE_DEFAULT_STEPS=50
IMAGE_AUTO_DISPATCH=1
# Video jobs use the persistent venv; it survives pause/resume.
REMOTE_PYTHON=/home/venv/bin/python
# Pin the running machine id; resume can return a new one.
JARVIS_MACHINE_ID=

# --- Video via Telegram (Wan 2.1 T2V through the backend) ---
VIDEO_MODEL_SIZE=1.3B
VIDEO_DURATION=3
VIDEO_STEPS=25
VIDEO_DAILY_LIMIT=3

# --- Girlfriend image app: GPU service (scripts/image_server.py) ---
IMAGE_API_URL=http://127.0.0.1:6006
IMAGE_API_TOKEN=
IMAGE_MODEL_ID=OpenMOSS-Team/MOSS-Image-SFT
IMAGE_CUSTOM_PIPELINE=pipeline_moss_image
IMAGE_FP32_VAE=1
IMAGE_SKIP_LAYERS=22
# Reference-edit model (FLUX.2 klein 4B, ~13 GB, Apache-2.0).
REFERENCE_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# Optional adapter (adult content). Empty = base model only.
IMAGE_LORA_DIR=
IMAGE_LORA_SCALE=0.5
# Character LoRA: route /imagine through FLUX.2 + the trained adapter.
IMAGE_USE_CHARACTER=0
CHARACTER_LORA_DIR=
CHARACTER_LORA_SCALE=0.7
CHARACTER_TRIGGER=gbrla
IMAGE_TIMEOUT=180
