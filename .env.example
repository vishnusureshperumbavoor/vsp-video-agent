# JarvisLabs API token used by scripts/wan_animate_runner.py
# Copy to .env (gitignored) and fill in.
JARVIS_LABS_API_TOKEN=

# Optional, for faster Hugging Face model downloads on the remote instance.
HF_TOKEN=

# --- Girlfriend image app: backend (FastAPI) ---
# Shared secret the Telegram bot presents; generate with `openssl rand -hex 32`.
BOT_INTERNAL_TOKEN=
TELEGRAM_BOT_TOKEN=
# Lock the bot to one Telegram chat (the bot uploads photos, so no public URL
# is needed for Telegram to reach the backend).
TELEGRAM_CHAT_ID=
BACKEND_URL=http://localhost:8000
# Optional: absolute image URLs for web clients; Telegram does not need it.
PUBLIC_BASE_URL=
IMAGE_DB_PATH=data/girlfriend.db
DAILY_IMAGE_LIMIT=10
IMAGE_DEFAULT_STEPS=50
IMAGE_AUTO_DISPATCH=1

# --- Girlfriend image app: GPU service (scripts/image_server.py) ---
IMAGE_API_URL=http://127.0.0.1:6006
IMAGE_API_TOKEN=
IMAGE_MODEL_ID=OpenMOSS-Team/MOSS-Image-SFT
IMAGE_CUSTOM_PIPELINE=pipeline_moss_image
IMAGE_FP32_VAE=1
IMAGE_SKIP_LAYERS=22
IMAGE_TIMEOUT=180
